							</ul>
        				</li>
					</ul>
					<ul class="navbar-nav">
                        <li class="nav-item">
                            <a id="refresh" href="#" class="nav-link app-nav-link"><span class="fas fa-sync-alt me-1" aria-hidden="true"></span> Refresh</a>
                        </li>
						<li class="nav-item">
							<a class="nav-link app-nav-link app-nav-logout" href="{{req.contextPath}}/logout"><span class="fas fa-power-off me-1" aria-hidden="true"></span> Log Out</a>
						</li>
					</ul>
				</div>
			</div>
		</nav>
	</header>

    <main role="main" class="{{#mainClasses}}{{.}}{{/mainClasses}}{{^mainClasses}}container{{/mainClasses}}"></main>