<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Error</title>

    {{>fragments/css}}
    <link rel="stylesheet" type="text/css" href="{{req.contextPath}}/css/auxiliary.css?v=1">

    <script type="text/javascript" src="{{req.contextPath}}/webjars/jquery/jquery.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            sessionStorage.clear(); // clear the browser session just in case there's anything there
        });
    </script>
</head>
<body class="aux-page">
<main class="aux-shell container">
    <section class="aux-card" aria-labelledby="page-title">
        <div class="row g-0">
            <div class="col-md-4 aux-brand d-flex flex-row flex-md-column align-items-center justify-content-between justify-content-md-center">
                <img src="{{req.contextPath}}/images/coach-logo.png" alt="COACH" class="aux-logo">
                <div class="aux-brand-icon" aria-hidden="true"><span class="fas fa-exclamation-triangle"></span></div>
            </div>
            <div class="col-md-8 aux-content">
                <p class="aux-eyebrow">Error</p>
                <h1 id="page-title" class="aux-title">Something Went Wrong</h1>
                <p class="aux-message">We were unable to complete your request.</p>
                <p class="aux-detail">
                    Please try again later. If the problem persists, please contact the COACH study team and include
                    the approximate time this occurred.
                </p>
                <p class="aux-note">
                    <span class="fas fa-info-circle me-1" aria-hidden="true"></span>
                    Technical details are available in the server logs.
                </p>
            </div>
        </div>
    </section>
</main>
</body>
</html>
