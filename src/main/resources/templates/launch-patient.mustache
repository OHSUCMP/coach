<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{applicationName}} - Loading</title>
    <script type="text/javascript" src="{{req.contextPath}}/webjars/jquery/jquery.min.js"></script>

    <!-- SMART on FHIR client library - see: https://docs.smarthealthit.org/client-js/#installation -->
    <script type="text/javascript" src="{{req.contextPath}}/js/client-js/v2-6-3/fhir-client.min.js"></script>

    <script type="text/javascript">
        function clearSession(_callback) {
            $.ajax({
                method: "POST",
                url: "/clear-session"
            }).always(function() {
                _callback();
            });
        }

        $(document).ready(function() {
            clearSession(function() {
                FHIR.oauth2.authorize({
                    "client_id": "{{clientId}}",
                    "scope": "{{scope}}",
                    "redirect_uri": "{{redirectUri}}",
                    "iss": "{{iss}}"
                });
            });
        });
    </script>
</head>
<body style="font-size:1.5em;">
Loading...
</body>
</html>